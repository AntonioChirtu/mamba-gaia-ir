# Run: python src/train.py experiment=clip_pretrained_text_exp

defaults:
  - override /data: gaia
  - override /model: mamba3
  - override /model/text_net: clip_pretrained
  - override /callbacks: default
  - override /trainer: default

tags: ["gaia", "clip_pretrained_text"]

trainer:
  min_epochs: 10
  max_epochs: 100
  gradient_clip_val: 0.5
  gradient_clip_algorithm: "norm"
  precision: bf16-mixed